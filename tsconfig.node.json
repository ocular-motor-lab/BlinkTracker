{
  "compilerOptions": {
    "composite": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "outDir": "dist-electron",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["src/shared/*"],
      "@ipc/*": ["ipc/*"]
    }
  },
  "include": [
    "electron/**/*.ts",
    "electron/**/*.cts",
    "ipc/**/*.ts",
    "src/shared/**/*.ts",
    "shared/**/*.json"
  ]
}
